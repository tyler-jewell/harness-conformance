  "files": ["bin", "src", "fixtures", "pins", "docs", "templates", "README.md", "LICENSE"],
  "scripts": { "test": "bash tests/run.sh", "check": "bash tests/run.sh && node bin/harness-conformance list" },
  "repository": { "type": "git", "url": "git+https://github.com/tyler-jewell/harness-conformance.git" },
  "keywords": ["claude-code", "opencode", "grok", "codex", "conformance", "mock-llm", "agents"]
}
